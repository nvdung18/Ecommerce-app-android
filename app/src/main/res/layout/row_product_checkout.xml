<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="5dp"
    app:cardElevation="0dp"
    app:contentPadding="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/Ll_info_product"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brown_bland"
        android:padding="10dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/img_ProductCheckout"
            android:layout_width="90dp"
            android:layout_height="100dp"
            android:padding="5dp"
            android:background="@color/white"
            android:src="@drawable/bags"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nameproTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/infoProduct"
                android:layout_toRightOf="@id/imgPro"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:layout_marginStart="8dp"
                android:text="maquochuysusdadasdasaaydsuayduaas"
                android:padding="2dp"
                android:textColor="@color/black"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/categoryproductTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:padding="2dp"
                android:text="daskdjskaljdds"
                android:textAlignment="textStart"
                android:textSize="20sp" />

            <LinearLayout
                android:id="@+id/Llcateandquantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/price_checkout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="daskdjskaljdds"
                    android:textAlignment="textStart"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/quantityproductTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="10dp"
                    android:text="x1"
                    android:textAlignment="center"
                    android:textSize="20dp" />

            </LinearLayout>
        </LinearLayout>


    </LinearLayout>
</androidx.cardview.widget.CardView>